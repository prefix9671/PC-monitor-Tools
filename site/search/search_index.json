{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":[" "],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"index.html","title":"\uc2dc\uc2a4\ud15c \ub9ac\uc18c\uc2a4 \ubaa8\ub2c8\ud130 \uc0ac\uc6a9\uc790 \ub9e4\ub274\uc5bc","text":"<p>\uc774 \ubb38\uc11c\ub294 \uc2e4\ud589 \ud30c\uc77c \ub610\ub294 Streamlit \uc571\uc73c\ub85c \uc81c\uacf5\ub418\ub294 <code>System Resource Monitor</code>\ub97c \uc0ac\uc6a9\uc790 \uad00\uc810\uc5d0\uc11c \uc124\uba85\ud558\ub294 \ub2e8\uc77c \ub9e4\ub274\uc5bc\uc785\ub2c8\ub2e4. \ube4c\ub4dc\ub41c <code>site/index.html</code>\ub9cc \uc5f4\uc5b4\ub3c4 \uc0ac\uc6a9 \ubc29\ubc95\uc744 \ud655\uc778\ud560 \uc218 \uc788\ub3c4\ub85d \uad6c\uc131\ud588\uc2b5\ub2c8\ub2e4.</p>"},{"location":"index.html#1","title":"1. \ud504\ub85c\uadf8\ub7a8 \uc2e4\ud589","text":"<ol> <li>\ud504\ub85c\uadf8\ub7a8\uc744 \uc2e4\ud589\ud569\ub2c8\ub2e4.</li> <li>\ubaa8\ub2c8\ud130\ub9c1\uc744 \uc2dc\uc791\ud558\ub824\uba74 \uc67c\ucabd \ud328\ub110\uc5d0\uc11c \uc218\uc9d1 \uac04\uaca9\uc744 \uc124\uc815\ud569\ub2c8\ub2e4.</li> <li> <p><code>Start Monitor (Admin)</code> \ubc84\ud2bc\uc744 \ub20c\ub7ec \uc218\uc9d1\uc744 \uc2dc\uc791\ud569\ub2c8\ub2e4.</p> </li> <li> <p>\ub85c\uadf8 \uc800\uc7a5 \uc704\uce58: <code>C:\\SystemLogs</code></p> </li> <li>\uc8fc\uc694 \ub85c\uadf8 \ud30c\uc77c:</li> <li><code>Global_Usage_*.csv</code> (\uace0\uc8fc\uae30 \uc2dc\uc2a4\ud15c \uc9c0\ud45c)</li> <li><code>System_Log_*.csv</code> (\ud504\ub85c\uc138\uc2a4 Top5 \uc694\uc57d)</li> </ol> <p></p>"},{"location":"index.html#2","title":"2. \ud654\uba74 \uad6c\uc131","text":""},{"location":"index.html#21-control-panel","title":"2.1 Control Panel","text":"<p>\uc67c\ucabd \uc0ac\uc774\ub4dc\ubc14\uc5d0\uc11c \ub2e4\uc74c \ud56d\ubaa9\uc744 \uc124\uc815\ud569\ub2c8\ub2e4.</p> <ul> <li><code>Global Interval (s)</code>: \uc2dc\uc2a4\ud15c \uc9c0\ud45c \uc218\uc9d1 \uc8fc\uae30</li> <li><code>Process Interval (s)</code>: \ud504\ub85c\uc138\uc2a4 Top5 \uc218\uc9d1 \uc8fc\uae30</li> <li><code>Target Drives</code>: \uc2a4\ud1a0\ub9ac\uc9c0 \ubaa8\ub2c8\ud130\ub9c1 \ub300\uc0c1 \ub4dc\ub77c\uc774\ube0c</li> <li><code>Start Monitor (Admin)</code>: \uad00\ub9ac\uc790 \uad8c\ud55c\uc73c\ub85c \uc218\uc9d1 \uc2dc\uc791</li> <li><code>Stop Monitor (Logman Only)</code>: Logman \uc138\uc158 \uc911\uc9c0</li> </ul>"},{"location":"index.html#22-log-file-selection","title":"2.2 Log File Selection","text":"<ul> <li><code>Upload Log CSV(s)</code>: \uc9c1\uc811 CSV \uc5c5\ub85c\ub4dc</li> <li><code>Select from C:\\SystemLogs</code>: \ub85c\uceec \uc800\uc7a5 \ub85c\uadf8 \uc120\ud0dd</li> <li><code>Time Range</code>: \uc120\ud0dd \uad6c\uac04\ub9cc \ubd84\uc11d</li> </ul>"},{"location":"index.html#3","title":"3. \ub300\uc2dc\ubcf4\ub4dc \uc120\ud0dd \ubc0f \uacf5\ud1b5 \uc870\uc791","text":"<p>\uc0c1\ub2e8 <code>Select Dashboard View</code>\uc5d0\uc11c \uc6d0\ud558\ub294 \ud654\uba74\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4.</p> <ul> <li>CPU Dashboard</li> <li>Memory Dashboard</li> <li>Storage (D:)</li> <li>Custom Graph</li> </ul> <p>\uadf8\ub798\ud504 \uc6b0\uce21 \uc0c1\ub2e8 \ud234\ubc14\uc5d0\uc11c \ud655\ub300/\ucd95\uc18c/\uc774\ub3d9/\ub9ac\uc14b/\uc774\ubbf8\uc9c0 \uc800\uc7a5\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4.</p> <p></p>"},{"location":"index.html#4-storage","title":"4. Storage \ub300\uc2dc\ubcf4\ub4dc \uc0ac\uc6a9\ubc95","text":"<p>Storage \ud654\uba74\uc740 \ub300\uc6a9\ub7c9 \ub85c\uadf8\uc5d0\uc11c\ub3c4 \ub3d9\uc791\ud558\ub3c4\ub85d \ucc28\ud2b8 \ud488\uc9c8 \uc635\uc158\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.</p> <ul> <li><code>Fast</code>: \uac00\uc7a5 \ube60\ub984, \uc694\uc57d \ud655\uc778\uc6a9</li> <li><code>Balanced</code>(\uae30\ubcf8): \uc18d\ub3c4\uc640 \ud615\ud0dc \ubcf4\uc874 \uade0\ud615</li> <li><code>Detailed</code>: \ud615\ud0dc \ud655\uc778 \uac15\ud654</li> <li><code>Original (slow)</code>: \uc6d0\ubcf8 \ud3ec\uc778\ud2b8 \uadf8\ub300\ub85c \ud45c\uc2dc(\ub300\uc6a9\ub7c9\uc5d0\uc11c\ub294 \ub290\ub9bc)</li> </ul> <p>\uad8c\uc7a5 \uc21c\uc11c:</p> <ol> <li>\uba3c\uc800 <code>Balanced</code>\ub85c \uc804\uccb4 \ucd94\uc138 \ud655\uc778</li> <li>\uc774\uc0c1 \uad6c\uac04\uc774 \uc788\uc73c\uba74 <code>Detailed</code>\ub85c \ud655\ub300 \ubd84\uc11d</li> <li>\ucd5c\uc885 \uac80\uc99d\uc774 \ud544\uc694\ud560 \ub54c\ub9cc <code>Original (slow)</code> \uc0ac\uc6a9</li> </ol> <p></p>"},{"location":"index.html#5-cpumemory","title":"5. CPU/Memory \ub300\uc2dc\ubcf4\ub4dc","text":""},{"location":"index.html#51-cpu-dashboard","title":"5.1 CPU Dashboard","text":"<ul> <li>CPU \uc0ac\uc6a9\ub960 \ucd94\uc774</li> <li>(\uc218\uc9d1 \uc2dc) CPU \uc628\ub3c4 \ucd94\uc774</li> <li>\ucd5c\ub300/\ud3c9\uade0 CPU \uc0ac\uc6a9\ub960 \uc9c0\ud45c</li> </ul>"},{"location":"index.html#52-memory-dashboard","title":"5.2 Memory Dashboard","text":"<ul> <li>\uba54\ubaa8\ub9ac \uc0ac\uc6a9\ub960/\uc2a4\uc651 \ucd94\uc774</li> <li>\uba54\ubaa8\ub9ac Top \ud504\ub85c\uc138\uc2a4</li> <li>\ud504\ub85c\uc138\uc2a4\ubcc4 \uba54\ubaa8\ub9ac \uc2dc\uacc4\uc5f4</li> </ul>"},{"location":"index.html#6-custom-graph","title":"6. Custom Graph + \uc5d1\uc140 \ub0b4\ubcf4\ub0b4\uae30","text":"<ol> <li><code>Custom Graph</code>\uc5d0\uc11c \uc2dc\uac01\ud654\ud560 \uc9c0\ud45c\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4.</li> <li><code>Export Start Time</code>\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4.</li> <li><code>Download as Excel (.xlsx)</code> \ubc84\ud2bc\uc73c\ub85c \ub0b4\ubcf4\ub0c5\ub2c8\ub2e4.</li> </ol>"},{"location":"index.html#7","title":"7. \ubb38\uc81c \ud574\uacb0","text":""},{"location":"index.html#71","title":"7.1 \ub85c\uadf8\uac00 \ubcf4\uc774\uc9c0 \uc54a\uc744 \ub54c","text":"<ul> <li><code>C:\\SystemLogs</code> \ud3f4\ub354\uac00 \uc0dd\uc131\ub418\uc5c8\ub294\uc9c0 \ud655\uc778</li> <li><code>Start Monitor (Admin)</code>\ub97c \uad00\ub9ac\uc790 \uad8c\ud55c\uc73c\ub85c \uc2e4\ud589\ud588\ub294\uc9c0 \ud655\uc778</li> </ul>"},{"location":"index.html#72","title":"7.2 \uadf8\ub798\ud504\uac00 \ube44\uc815\uc0c1\uc801\uc73c\ub85c \ub290\ub9b4 \ub54c","text":"<ul> <li>Storage \ud654\uba74 <code>Chart Quality</code>\ub97c <code>Fast</code> \ub610\ub294 <code>Balanced</code>\ub85c \ubcc0\uacbd</li> <li><code>Time Range</code>\ub97c \uc881\ud600\uc11c \ub2e4\uc2dc \ud655\uc778</li> </ul>"},{"location":"index.html#73","title":"7.3 \ub370\uc774\ud130\uac00 \ube44\uc5b4 \ubcf4\uc77c \ub54c","text":"<ul> <li>\ub85c\uadf8 \ud30c\uc77c \uc120\ud0dd\uc774 \uc62c\ubc14\ub978\uc9c0 \ud655\uc778</li> <li>\ub85c\uadf8 \uc218\uc9d1 \uc2dc\uc791 \uc2dc\uac01\uacfc \ubd84\uc11d \uc2dc\uac01\uc774 \uc77c\uce58\ud558\ub294\uc9c0 \ud655\uc778</li> </ul>"},{"location":"reliability_report.html","title":"\uc2dc\uc2a4\ud15c \uc2e0\ub8b0\uc131 \ubc0f \uac80\uc0ac \ud6a8\uc728 \ubd84\uc11d \ubcf4\uace0\uc11c (Reliability Report)","text":""},{"location":"reliability_report.html#1-executive-summary","title":"1. \uac1c\uc694 (Executive Summary)","text":"<p>\ubcf8 \ubcf4\uace0\uc11c\ub294 AOI(Automated Optical Inspection) \uc7a5\ube44\uc758 \uace0\uc815\ubc00 \uac80\uc0ac \ud658\uacbd\uc5d0\uc11c \ubcf8 \ubaa8\ub2c8\ud130\ub9c1 \uc2dc\uc2a4\ud15c\uc774 \uc7a5\ube44 \uc18c\ud504\ud2b8\uc6e8\uc5b4\uc758 \uc131\ub2a5\uacfc \uc2e0\ub8b0\uc131\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc744 \ubd84\uc11d\ud569\ub2c8\ub2e4. \uacbd\uc601\uc9c4(C-Level) \ubc0f QA \ud300\uc740 \ubcf8 \ub3c4\uad6c\ub97c \ud1b5\ud574 \uac80\uc0ac \uc18d\ub3c4(Cycle Time) \uc190\uc2e4 \uc5c6\uc774 \uc2dc\uc2a4\ud15c\uc758 \uc7a0\uc7ac\uc801 \ub9ac\uc2a4\ud06c(Disk I/O \ubcd1\ubaa9, DB \ubd80\ud558 \ub4f1)\ub97c \uac1d\ucc29\ud558\uace0 \ub300\uc751\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p>"},{"location":"reliability_report.html#2-architecture-stability","title":"2. \ubaa8\ub2c8\ud130\ub9c1 \uc544\ud0a4\ud14d\ucc98 \ubc0f \uc548\uc804\uc131 (Architecture &amp; Stability)","text":"<p>\ubcf8 \uc2dc\uc2a4\ud15c\uc740 \uc7a5\ube44\uc758 \uc2e4\uc2dc\uac04 \uac80\uc0ac \ub85c\uc9c1\uacfc \uc644\uc804\ud788 \ubd84\ub9ac\ub41c \ube44\uce68\uc2b5\uc801(Non-invasive) \ubc29\uc2dd\uc744 \ucc44\ud0dd\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.</p> <ul> <li>\uc708\ub3c4\uc6b0 \ud45c\uc900 \uc131\ub2a5 \uce74\uc6b4\ud130 (Logman): OS \uc218\uc900\uc5d0\uc11c \ucee4\ub110 \ub370\uc774\ud130\uc5d0 \uc9c1\uc811 \uc811\uadfc\ud558\ubbc0\ub85c, \uc560\ud50c\ub9ac\ucf00\uc774\uc158 \ub808\ubca8\uc758 CPU \uc810\uc720\uc728\uc774 1% \ubbf8\ub9cc\uc73c\ub85c \uadf9\ud788 \ub0ae\uc2b5\ub2c8\ub2e4. (5\ucd08 \uc8fc\uae30 \uc124\uc815 \uc2dc \uc601\ud5a5\ub3c4 \ubb34\uc2dc \uac00\ub2a5)</li> <li>PowerShell \uae30\ubc18 \ud504\ub85c\uc138\uc2a4 \ucd94\uc801: 30\ucd08\uc758 \uae34 \uc8fc\uae30\ub85c \ub3d9\uc791\ud558\uc5ec, \uac80\uc0ac \uc18c\ud504\ud2b8\uc6e8\uc5b4\uc758 \ud504\ub85c\uc138\uc2a4 \ucee8\ud14d\uc2a4\ud2b8 \uc2a4\uc704\uce6d\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc744 \ucd5c\uc18c\ud654\ud569\ub2c8\ub2e4.</li> <li>\ub370\uc774\ud130 \uc800\uc7a5\uc18c: \uc218\uc9d1\ub41c \ub85c\uadf8\ub294 \ube44\ub3d9\uae30\uc801\uc73c\ub85c \uae30\ub85d\ub418\uba70, \uac80\uc0ac \uc54c\uace0\ub9ac\uc998\uc758 \uba54\ubaa8\ub9ac \uc601\uc5ed\uc744 \uce68\ubc94\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.</li> </ul>"},{"location":"reliability_report.html#3-impact-analysis","title":"3. \ud575\uc2ec \uc2dc\uc2a4\ud15c \uc601\ud5a5 \ubd84\uc11d (Impact Analysis)","text":""},{"location":"reliability_report.html#31-cycle-time","title":"3.1 \uac80\uc0ac \uc18d\ub3c4 (Cycle Time) \ubcf4\uc874","text":"<p>AOI \uac80\uc0ac\ub294 \uace0\ud574\uc0c1\ub3c4 \uc774\ubbf8\uc9c0 \ucc98\ub9ac\uc640 \uc815\ubc00 \uc81c\uc5b4\uac00 \ud575\uc2ec\uc785\ub2c8\ub2e4. \ubcf8 \ub3c4\uad6c\ub294 \ub2e4\uc74c \ubc29\uc2dd\uc73c\ub85c \uac80\uc0ac \uc18d\ub3c4\ub97c \ubcf4\ud638\ud569\ub2c8\ub2e4. - CPU \uc120\uc810 \ubc29\uc9c0: \ubaa8\ub2c8\ud130\ub9c1 \ud504\ub85c\uc138\uc2a4\ub294 \ub0ae\uc740 \uc6b0\uc120\uc21c\uc704\ub85c \ub3d9\uc791\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. - Interrupt \uad00\ub9ac: \ub124\ud2b8\uc6cc\ud06c \uae30\ubc18 \ubaa8\ub2c8\ud130\ub9c1 \ub300\uc2e0 \ub85c\uceec \ub85c\uadf8 \ubc29\uc2dd\uc744 \uc6b0\uc120\ud558\uc5ec \ub124\ud2b8\uc6cc\ud06c \uc9c0\uc5f0\uc5d0 \ub530\ub978 \uc0ac\uc774\ub4dc \uc774\ud399\ud2b8\ub97c \ucc28\ub2e8\ud569\ub2c8\ub2e4.</p>"},{"location":"reliability_report.html#32-db","title":"3.2 \ub85c\uceec DB \uc5d4\uc9c4 \ubc0f \uae30\ud0c0 \ud504\ub85c\uadf8\ub7a8 \ubaa8\ub2c8\ud130\ub9c1","text":"<p>AOI \uc2dc\uc2a4\ud15c\uc5d0\uc11c MSSQL/PostgreSQL \ub4f1 \ub85c\uceec DB\uc758 \uc131\ub2a5 \uc800\ud558\ub294 \uac80\uc0ac \uacb0\uacfc \uae30\ub85d \uc9c0\uc5f0\uc73c\ub85c \uc774\uc5b4\uc9d1\ub2c8\ub2e4. - Disk I/O \ucd94\uc801: DB \uc5d4\uc9c4\uc758 <code>Write Bytes/sec</code>\uc640 <code>Disk Queue Length</code>\ub97c \ubaa8\ub2c8\ud130\ub9c1\ud558\uc5ec, DB \uc800\uc7a5 \uc9c0\uc5f0\uc774 \uac80\uc0ac \uc18d\ub3c4\uc5d0 \ubbf8\uce58\ub294 \uc0c1\uad00\uad00\uacc4\ub97c QA\uac00 \uc989\uc2dc \ud30c\uc545\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. - \uc790\uc6d0 \uacbd\ud569 \ud0d0\uc0c9: \ud0c0\uc0ac \ubc31\uc2e0\uc774\ub098 \uae30\ud0c0 \ubc31\uadf8\ub77c\uc6b4\ub4dc \ud504\ub85c\uadf8\ub7a8\uc774 CPU \ud53c\ud06c\ub97c \uc720\ubc1c\ud560 \ub54c, \ud574\ub2f9 \uc2dc\uc810\uc5d0 AOI \uac80\uc0ac\uac00 \uc9c0\uc5f0\ub418\uc5c8\ub294\uc9c0 \ud0c0\uc784\ub77c\uc778\uc744 \ud1b5\ud574 \uad50\ucc28 \uac80\uc99d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p>"},{"location":"reliability_report.html#4-qa-operational-strategy","title":"4. QA \uc6b4\uc601 \uc804\ub7b5 (Operational Strategy)","text":"<p>QA \ud300\uc740 \ubcf8 \ub3c4\uad6c\ub97c \ud1b5\ud574 \ub2e4\uc74c\uacfc \uac19\uc740 OS \ub808\ubca8\uc758 \uc774\uc288\ub97c \uc9c4\ub2e8\ud569\ub2c8\ub2e4.</p> <ol> <li>\uba54\ubaa8\ub9ac \ub9ad(Memory Leak) \uc870\uae30 \ubc1c\uacac: \uac80\uc0ac \uc18c\ud504\ud2b8\uc6e8\uc5b4\uc758 \uba54\ubaa8\ub9ac \uc810\uc720\uc728\uc774 \uc2dc\uac04\uc5d0 \ub530\ub77c \uc6b0\uc0c1\ud5a5 \ud558\ub294\uc9c0 \uac10\uc2dc\ud558\uc5ec \uc7a5\uae30 \uac00\ub3d9 \uc2dc\uc758 \uc7a5\ube44 \ub2e4\uc6b4\ud0c0\uc784\uc744 \uc608\ubc29\ud569\ub2c8\ub2e4.</li> <li>\ub514\uc2a4\ud06c \ub178\ud6c4\ud654 \uc9c4\ub2e8: \ud2b9\uc815 \uc77c\uc2dc\ubd80\ud130 <code>Disk Read/Write</code> \uc18d\ub3c4\uac00 \uc800\ud558\ub418\uac70\ub098 \ud050 \uae38\uc774\uac00 \ub298\uc5b4\ub098\ub294 \uacbd\uc6b0, \uc7a5\ube44\uc758 SSD/HDD \uad50\uccb4 \uc2dc\uae30\ub97c \uac1d\uad00\uc801 \uc218\uce58\ub85c \uc81c\uc548\ud569\ub2c8\ub2e4.</li> <li>\uac80\uc0ac \uc18d\ub3c4 \uc0c1\uad00\uad00\uacc4 \ubd84\uc11d: \uc81c\ud488 \uac80\uc0ac \uc2dc\uac04\uc774 \ud3c9\uc18c\ubcf4\ub2e4 \uae38\uc5b4\uc9c4 \uacbd\uc6b0, \ud574\ub2f9 \uad6c\uac04\uc758 CPU \ud53c\ud06c \uc5ec\ubd80\ub97c \ud655\uc778\ud558\uc5ec \ucf54\ub4dc \ucd5c\uc801\ud654 \ud544\uc694\uc131\uc744 \ud310\ub2e8\ud569\ub2c8\ub2e4.</li> </ol>"},{"location":"reliability_report.html#5-conclusion","title":"5. \uacb0\ub860 (Conclusion)","text":"<p>\ubcf8 \ubaa8\ub2c8\ud130\ub9c1 \uc2dc\uc2a4\ud15c\uc740 AOI \uc7a5\ube44\uc758 \uace0\uc720 \uae30\ub2a5\uc744 \uc800\ud574\ud558\uc9c0 \uc54a\uc73c\uba74\uc11c\ub3c4, \uc2dc\uc2a4\ud15c\uc758 \ud22c\uba85\uc131\uc744 \uadf9\ub300\ud654\ud569\ub2c8\ub2e4. \uc774\ub294 \uc7a5\ube44\uc758 \uac00\uc131\ube44(Uptime)\ub97c \ub192\uc774\uace0, \ud604\uc7a5\uc5d0\uc11c \ubc1c\uc0dd\ud558\ub294 \uc6d0\uc778 \ubd88\uba85\uc758 \uac80\uc0ac \uc9c0\uc5f0 \uc774\uc288\ub97c \ub370\uc774\ud130 \uae30\ubc18(Data-driven)\uc73c\ub85c \ud574\uacb0\ud558\ub294 \uac15\ub825\ud55c QA \uae30\ubc18\uc774 \ub429\ub2c8\ub2e4.</p>"}]}