{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":[" "],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"index.html","title":"\uc2dc\uc2a4\ud15c \ub9ac\uc18c\uc2a4 \ubaa8\ub2c8\ud130 \uc0ac\uc6a9\uc790 \ub9e4\ub274\uc5bc","text":"<p>\uc774 \ubb38\uc11c\ub294 \uc2e4\ud589 \ud30c\uc77c \ub610\ub294 Streamlit \uc571\uc73c\ub85c \uc81c\uacf5\ub418\ub294 <code>System Resource Monitor</code>\ub97c \uc0ac\uc6a9\uc790 \uad00\uc810\uc5d0\uc11c \uc124\uba85\ud558\ub294 \ub2e8\uc77c \ub9e4\ub274\uc5bc\uc785\ub2c8\ub2e4. \ube4c\ub4dc\ub41c <code>site/index.html</code>\ub9cc \uc5f4\uc5b4\ub3c4 \uc0ac\uc6a9 \ubc29\ubc95\uc744 \ud655\uc778\ud560 \uc218 \uc788\ub3c4\ub85d \uad6c\uc131\ud588\uc2b5\ub2c8\ub2e4.</p>"},{"location":"index.html#1","title":"1. \ud504\ub85c\uadf8\ub7a8 \uc2e4\ud589","text":"<ol> <li>\ud504\ub85c\uadf8\ub7a8\uc744 \uc2e4\ud589\ud569\ub2c8\ub2e4.</li> <li>\ubaa8\ub2c8\ud130\ub9c1\uc744 \uc2dc\uc791\ud558\ub824\uba74 \uc67c\ucabd \ud328\ub110\uc5d0\uc11c \uc218\uc9d1 \uac04\uaca9\uc744 \uc124\uc815\ud569\ub2c8\ub2e4.</li> <li> <p><code>Start Monitor (Admin)</code> \ubc84\ud2bc\uc744 \ub20c\ub7ec \uc218\uc9d1\uc744 \uc2dc\uc791\ud569\ub2c8\ub2e4.</p> </li> <li> <p>\ub85c\uadf8 \uc800\uc7a5 \uc704\uce58: <code>C:\\SystemLogs</code></p> </li> <li>\uc8fc\uc694 \ub85c\uadf8 \ud30c\uc77c:</li> <li><code>resource_*.csv</code> (\uc2dc\uc2a4\ud15c \uc790\uc6d0: CPU/Mem/Disk 5\ucd08 \uc9d1\uacc4)</li> <li><code>process_*.csv</code> (\ud504\ub85c\uc138\uc2a4\ubcc4 \uc790\uc6d0 \uc810\uc720 Top5 \uc694\uc57d)</li> <li><code>summary_*.log</code> (\uc218\uc9d1\uae30 \ub3d9\uc791 \uc0c1\ud0dc \ubc0f \uc774\uc288 \uae30\ub85d)</li> </ol> <p></p>"},{"location":"index.html#2","title":"2. \ud654\uba74 \uad6c\uc131","text":""},{"location":"index.html#21-control-panel","title":"2.1 Control Panel","text":"<p>\uc67c\ucabd \uc0ac\uc774\ub4dc\ubc14\uc5d0\uc11c \ub2e4\uc74c \ud56d\ubaa9\uc744 \uc124\uc815\ud569\ub2c8\ub2e4.</p> <ul> <li>\ud83d\udca1 \uc218\uc9d1 \uc815\ucc45: 1\ucd08 \uc0d8\ud50c\ub9c1 / 5\ucd08 \ud3c9\uade0 \ubc0f Peak \uc9d1\uacc4 (\uace0\uc815 \ubc29\uc2dd)</li> <li>Start Monitor: \uad00\ub9ac\uc790 \uad8c\ud55c\uc73c\ub85c \ud30c\uc774\uc36c \uc2e4\uc2dc\uac04 \uc218\uc9d1\uae30 \uac00\ub3d9</li> <li>Refresh Log Data \ud83d\udd04: \uce90\uc2dc\ub97c \ube44\uc6b0\uace0 \uc218\uc9d1 \uc911\uc778 \ucd5c\uc2e0 \ub85c\uadf8 \uc989\uc2dc \ubc18\uc601</li> <li>\uc218\uc9d1 \uc911\ub2e8: \ubc31\uadf8\ub77c\uc6b4\ub4dc\uc5d0\uc11c \uc2e4\ud589\ub41c \ud30c\uc774\uc36c \ucf58\uc194 \ucc3d\uc744 \ub2eb\uac70\ub098 Ctrl + C \uc785\ub825</li> <li>Target Drives: [\uc790\ub3d9] \uc2dc\uc2a4\ud15c \ud30c\ud2f0\uc158\uc744 \uc870\ud68c\ud558\uc5ec <code>C:</code>, <code>D:</code>, <code>E:</code> \ub4f1\uc744 \uc790\ub3d9 \uac10\uc9c0\ud568</li> </ul>"},{"location":"index.html#22-log-file-selection","title":"2.2 Log File Selection","text":"<ul> <li><code>Upload Log CSV(s)</code>: \uc9c1\uc811 CSV \uc5c5\ub85c\ub4dc</li> <li><code>Select from C:\\SystemLogs</code>: \ub85c\uceec \uc800\uc7a5 \ub85c\uadf8 \uc120\ud0dd</li> <li><code>Time Range</code>: \uc120\ud0dd \uad6c\uac04\ub9cc \ubd84\uc11d</li> </ul>"},{"location":"index.html#3","title":"3. \ub300\uc2dc\ubcf4\ub4dc \uc120\ud0dd \ubc0f \uacf5\ud1b5 \uc870\uc791","text":"<p>\uc0c1\ub2e8 <code>Select Dashboard View</code>\uc5d0\uc11c \uc6d0\ud558\ub294 \ud654\uba74\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4.</p> <ul> <li>CPU Dashboard</li> <li>Memory Dashboard</li> <li>Storage Dashboard (C:, D:, E: \ub4f1 \ud1b5\ud569 \ud45c\uc2dc)</li> <li>Custom Graph (\uc5d1\uc140 \ub0b4\ubcf4\ub0b4\uae30 \uc9c0\uc6d0)</li> </ul> <p>\uadf8\ub798\ud504 \uc6b0\uce21 \uc0c1\ub2e8 \ud234\ubc14\uc5d0\uc11c \ud655\ub300/\ucd95\uc18c/\uc774\ub3d9/\ub9ac\uc14b/\uc774\ubbf8\uc9c0 \uc800\uc7a5\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4.</p> <p></p>"},{"location":"index.html#4-storage","title":"4. Storage \ub300\uc2dc\ubcf4\ub4dc \uc0ac\uc6a9\ubc95","text":"<p>Storage \ud654\uba74\uc740 \ub300\uc6a9\ub7c9 \ub85c\uadf8\uc5d0\uc11c\ub3c4 \ub3d9\uc791\ud558\ub3c4\ub85d \ucc28\ud2b8 \ud488\uc9c8 \uc635\uc158\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.</p> <ul> <li><code>Fast</code>: \uac00\uc7a5 \ube60\ub984, \uc694\uc57d \ud655\uc778\uc6a9</li> <li><code>Balanced</code>(\uae30\ubcf8): \uc18d\ub3c4\uc640 \ud615\ud0dc \ubcf4\uc874 \uade0\ud615</li> <li><code>Detailed</code>: \ud615\ud0dc \ud655\uc778 \uac15\ud654</li> <li><code>Original (slow)</code>: \uc6d0\ubcf8 \ud3ec\uc778\ud2b8 \uadf8\ub300\ub85c \ud45c\uc2dc(\ub300\uc6a9\ub7c9\uc5d0\uc11c\ub294 \ub290\ub9bc)</li> </ul> <p>\uad8c\uc7a5 \uc21c\uc11c:</p> <ol> <li>\uba3c\uc800 <code>Balanced</code>\ub85c \uc804\uccb4 \ucd94\uc138 \ud655\uc778</li> <li>\uc774\uc0c1 \uad6c\uac04\uc774 \uc788\uc73c\uba74 <code>Detailed</code>\ub85c \ud655\ub300 \ubd84\uc11d</li> <li>\ucd5c\uc885 \uac80\uc99d\uc774 \ud544\uc694\ud560 \ub54c\ub9cc <code>Original (slow)</code> \uc0ac\uc6a9</li> </ol> <p></p>"},{"location":"index.html#5-cpumemory","title":"5. CPU/Memory \ub300\uc2dc\ubcf4\ub4dc","text":""},{"location":"index.html#51-cpu-dashboard","title":"5.1 CPU Dashboard","text":"<ul> <li>CPU \uc0ac\uc6a9\ub960 \ucd94\uc774</li> <li>(\uc218\uc9d1 \uc2dc) CPU \uc628\ub3c4 \ucd94\uc774</li> <li>\ucd5c\ub300/\ud3c9\uade0 CPU \uc0ac\uc6a9\ub960 \uc9c0\ud45c</li> </ul>"},{"location":"index.html#52-memory-dashboard","title":"5.2 Memory Dashboard","text":"<ul> <li>\uba54\ubaa8\ub9ac \uc0ac\uc6a9\ub960/\uc2a4\uc651 \ucd94\uc774</li> <li>\uba54\ubaa8\ub9ac Top \ud504\ub85c\uc138\uc2a4</li> <li>\ud504\ub85c\uc138\uc2a4\ubcc4 \uba54\ubaa8\ub9ac \uc2dc\uacc4\uc5f4</li> </ul>"},{"location":"index.html#6-custom-graph","title":"6. Custom Graph + \uc5d1\uc140 \ub0b4\ubcf4\ub0b4\uae30","text":"<ol> <li><code>Custom Graph</code>\uc5d0\uc11c \uc2dc\uac01\ud654\ud560 \uc9c0\ud45c\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4.</li> <li><code>Export Start Time</code>\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4.</li> <li><code>Download as Excel (.xlsx)</code> \ubc84\ud2bc\uc73c\ub85c \ub0b4\ubcf4\ub0c5\ub2c8\ub2e4.</li> </ol>"},{"location":"index.html#7","title":"7. \ubb38\uc81c \ud574\uacb0","text":""},{"location":"index.html#71","title":"7.1 \ub85c\uadf8\uac00 \ubcf4\uc774\uc9c0 \uc54a\uc744 \ub54c","text":"<ul> <li><code>C:\\SystemLogs</code> \ud3f4\ub354\uac00 \uc0dd\uc131\ub418\uc5c8\ub294\uc9c0 \ud655\uc778</li> <li><code>Start Monitor (Admin)</code>\ub97c \uad00\ub9ac\uc790 \uad8c\ud55c\uc73c\ub85c \uc2e4\ud589\ud588\ub294\uc9c0 \ud655\uc778</li> </ul>"},{"location":"index.html#72","title":"7.2 \uadf8\ub798\ud504\uac00 \ube44\uc815\uc0c1\uc801\uc73c\ub85c \ub290\ub9b4 \ub54c","text":"<ul> <li>Storage \ud654\uba74 <code>Chart Quality</code>\ub97c <code>Fast</code> \ub610\ub294 <code>Balanced</code>\ub85c \ubcc0\uacbd</li> <li><code>Time Range</code>\ub97c \uc881\ud600\uc11c \ub2e4\uc2dc \ud655\uc778</li> </ul>"},{"location":"index.html#73","title":"7.3 \ub370\uc774\ud130\uac00 \ube44\uc5b4 \ubcf4\uc77c \ub54c","text":"<ul> <li>\ub85c\uadf8 \ud30c\uc77c \uc120\ud0dd\uc774 \uc62c\ubc14\ub978\uc9c0 \ud655\uc778</li> <li>\ub85c\uadf8 \uc218\uc9d1 \uc2dc\uc791 \uc2dc\uac01\uacfc \ubd84\uc11d \uc2dc\uac01\uc774 \uc77c\uce58\ud558\ub294\uc9c0 \ud655\uc778</li> </ul>"},{"location":"Changelog.html","title":"\ubcc0\uacbd \uc774\ub825 (Changelog)","text":""},{"location":"Changelog.html#2026-03-25-","title":"[2026-03-25] - \ud3ec\ud130\ube14 \ubc30\ud3ec \ub300\uc751 \ubc0f \uc218\uc9d1\uae30 \uc815\uad50\ud654","text":""},{"location":"Changelog.html#fixes","title":"\ud574\uacb0\ub41c \ubc84\uadf8 (Fixes)","text":"<ul> <li>\ud3ec\ud130\ube14 \uc2e4\ud589 \"\uacbd\ub85c\ub97c \ucc3e\uc744 \uc218 \uc5c6\uc74c\" \ud574\uacb0: <code>start_monitor.bat</code>\uc774 \uac1c\ubc1c \ud658\uacbd\uc758 \uac00\uc0c1\ud658\uacbd(<code>venv</code>)\uacfc \uc18c\uc2a4 \ucf54\ub4dc(<code>cli.py</code>)\ub97c \uc9c1\uc811 \ud638\ucd9c\ud558\ub358 \uad6c\uc870\ub97c \ud0c8\ud53c\ud588\uc2b5\ub2c8\ub2e4. </li> <li>\uc784\uc2dc \uacbd\ub85c(<code>_MEIPASS</code>) \uaca9\ub9ac \ubb38\uc81c \ud574\uacb0: Streamlit \ub300\uc2dc\ubcf4\ub4dc \ub0b4\uc758 [Start Monitor] \ubc84\ud2bc\uc774 <code>sys.executable</code> (\uc6d0\ubcf8 EXE \uacbd\ub85c)\uc744 \uc9c1\uc811 \uac10\uc9c0\ud558\uc5ec \ubc31\uadf8\ub77c\uc6b4\ub4dc \ud504\ub85c\uc138\uc2a4\ub97c \ub744\uc6b0\ub3c4\ub85d \uc218\uc815\ud558\uc5ec, PyInstaller \uc784\uc2dc \ud3f4\ub354\uc5d0\uc11c \ubc1c\uc0dd\ud558\ub294 \uacbd\ub85c \uc778\uc2dd \uc624\ub958\ub97c \ud574\uacb0\ud588\uc2b5\ub2c8\ub2e4.</li> </ul>"},{"location":"Changelog.html#improvements","title":"\uae30\ub2a5 \uac1c\uc120 (Improvements)","text":"<ul> <li>Universal Entrypoint \ub3c4\uc785: <code>run_app.py</code>\uac00 \uc774\uc81c <code>sys.argv</code>\ub97c \ubd84\uc11d\ud558\uc5ec <code>start</code> \uc778\uc790\uac00 \ub4e4\uc5b4\uc624\uba74 \uc989\uc2dc \uc218\uc9d1\uae30(<code>cli.py</code>)\ub85c \ub3d9\uc791\ud558\uace0, \uc778\uc790\uac00 \uc5c6\uc73c\uba74 \ub300\uc2dc\ubcf4\ub4dc\ub85c \ub3d9\uc791\ud558\ub294 \ub2e8\uc77c \uc5d4\ud2b8\ub9ac\ud3ec\uc778\ud2b8 \uad6c\uc870\ub97c \uac00\uc9d1\ub2c8\ub2e4.</li> <li>\ub514\uc2a4\ud06c \ud65c\uc131 \uc2dc\uac04(%) \uc815\uad50\ud654: NVMe \ub4f1 \ucd08\uace0\uc18d \uc800\uc7a5\uc7a5\uce58\uc5d0\uc11c <code>psutil</code>\uc774 0.32%\uc640 \uac19\uc774 \uadf9\uc18c\uc218\uc810\uc73c\ub85c \ubcf4\uace0\ud558\ub358 \uac12\uc744, \uc0ac\uc6a9\uc790\uc758 \uc0c1\uc6a9 \uc0c1\uc2dd\uc5d0 \ubd80\ud569\ud558\ub3c4\ub85d 100\ubc30 \uc2a4\ucf00\uc77c\ub9c1\ud558\uc5ec \ubcf4\ub2e4 \uc9c1\uad00\uc801\uc778 32% \ud615\ud0dc\uc758 \uc9c0\ud45c\ub85c \uce98\ub9ac\ube0c\ub808\uc774\uc158\ud588\uc2b5\ub2c8\ub2e4.</li> </ul>"},{"location":"Changelog.html#_1","title":"\ubb38\uc11c \ubc0f \ud14c\uc2a4\ud2b8","text":"<ul> <li>\ud3ec\ud130\ube14 \uac80\uc99d \ub3c4\uad6c \ucd94\uac00: \ud30c\uc774\uc36c\uc774 \uc5c6\ub294 \ud658\uacbd\uc5d0\uc11c EXE \ud30c\uc77c\ub9cc\uc73c\ub85c \uac00\ub3d9\uc744 \uc785\uc99d\ud558\ub294 <code>test_portable.bat</code> \uc2a4\ud06c\ub9bd\ud2b8\ub97c \ucd94\uac00\ud558\uc5ec \ubc30\ud3ec \uc548\uc815\uc131\uc744 \ud655\ubcf4\ud588\uc2b5\ub2c8\ub2e4.</li> </ul>"},{"location":"Changelog.html#2026-03-24-psutil","title":"[2026-03-24] - \ud30c\uc774\uc36c psutil \uc218\uc9d1\uae30 \ub9c8\uc774\uadf8\ub808\uc774\uc158","text":"<p>\uc2dc\uc2a4\ud15c \ub9ac\uc18c\uc2a4 \ubaa8\ub2c8\ud130\ub9c1 \ub3c4\uad6c\uac00 \uae30\uc874\uc758 PowerShell/Logman \ud558\uc774\ube0c\ub9ac\ub4dc \ubc29\uc2dd\uc5d0\uc11c <code>psutil</code>\uc744 \ud65c\uc6a9\ud55c \uc21c\uc218 \ud30c\uc774\uc36c(Python) \uae30\ubc18 \uc218\uc9d1\uae30\ub85c \uc804\uba74 \uac1c\ud3b8\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc774\ub97c \ud1b5\ud574 \ub370\uc774\ud130 \uc218\uc9d1 \uacfc\uc815\uc774 \ud68d\uae30\uc801\uc73c\ub85c \ub2e8\uc21c\ud574\uc84c\uc73c\uba70, \ube44\ub3d9\uae30 \ubcd1\ud569 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uace0 \ub300\uc2dc\ubcf4\ub4dc\uc5d0\uc11c \ub354\uc6b1 \uc548\uc815\uc801\uc73c\ub85c \ub370\uc774\ud130\ub97c \ud45c\uc2dc\ud560 \uc218 \uc788\uac8c \ub418\uc5c8\uc2b5\ub2c8\ub2e4.</p>"},{"location":"Changelog.html#_2","title":"\uc8fc\uc694 \ubcc0\uacbd \uc0ac\ud56d","text":""},{"location":"Changelog.html#1","title":"1. \uc2e0\uaddc \ud30c\uc774\uc36c \uc218\uc9d1\uae30 \uc544\ud0a4\ud14d\ucc98","text":"<ul> <li><code>collectors/sampler.py</code>: CPU \uc0ac\uc6a9\ub7c9, \uba54\ubaa8\ub9ac \uc0c1\ud0dc, \ub4dc\ub77c\uc774\ube0c\ubcc4 \ub514\uc2a4\ud06c \uc18d\ub3c4, \ud504\ub85c\uc138\uc2a4\ubcc4 \uc790\uc6d0 \uc810\uc720\uc728\uc744 1\ucd08 \uac04\uaca9\uc73c\ub85c \ucd94\ucd9c\ud558\ub294 \ud558\ub4dc\uc6e8\uc5b4 \uc0d8\ud50c\ub7ec \uad6c\ud604. \uc2dc\uc791 \uc2dc Windows \ud30c\ud2f0\uc158 \uc815\ubcf4\ub97c \uc870\ud68c\ud558\uc5ec <code>PhysicalDriveX</code>\ub97c \uc2e4\uc81c \ub4dc\ub77c\uc774\ube0c \ubb38\uc790(<code>C:</code>, <code>D:</code> \ub4f1)\ub85c \uc790\ub3d9 \ub9e4\ud551.</li> <li><code>collectors/aggregator.py</code>: \ub370\uc774\ud130\uc758 \ub178\uc774\uc988\ub97c \uc904\uc774\uace0 \uc911\uc694\ud55c \uc2a4\ud30c\uc774\ud06c\ub97c \ubcf4\uc874\ud558\uae30 \uc704\ud574, 5\ucd08(Window) \ub2e8\uc704 \ub864\ub9c1 \ud3c9\uade0 \ubc0f \ucd5c\ub300\uac12(Peak IO, Avg Mem, Peak CPU \ub4f1)\uc744 \uacc4\uc0b0\ud558\ub294 \uc9d1\uacc4 \ub85c\uc9c1 \uad6c\ud604.</li> <li><code>collectors/writers.py</code>: \ud45c\uc900\ud654\ub41c \ud5e4\ub354\ub97c \uc801\uc6a9\ud558\uc5ec \ub0a0\uc9dc\ubcc4\ub85c \ub864\ub9c1\ub418\ub294 <code>resource_YYYYMMDD.csv</code> \ubc0f <code>process_YYYYMMDD.csv</code> \ucd9c\ub825 \uc2dc\uc2a4\ud15c \uad6c\ucd95.</li> <li><code>collectors/core.py</code> &amp; <code>cli.py</code>: \uae30\uc874\uc758 \ub2e8\uc77c \uba54\uc778 \ub8e8\ud504\ub97c \ubd84\ub9ac\ud558\uc5ec, \ud575\uc2ec \ub85c\uc9c1\uc744 \ub2f4\ub2f9\ud558\ub294 <code>MonitorEngine</code> \ubaa8\ub4c8\uacfc \ud130\ubbf8\ub110 \uc81c\uc5b4\ub97c \ub2f4\ub2f9\ud558\ub294 <code>cli.py</code> \ub3c4\uad6c\ub85c TDD \uae30\ubc18 \ub9ac\ud329\ud130\ub9c1\uc744 \uc644\ub8cc\ud588\uc2b5\ub2c8\ub2e4.</li> </ul>"},{"location":"Changelog.html#2-streamlit","title":"2. Streamlit \ub300\uc2dc\ubcf4\ub4dc \ubc0f \ub370\uc774\ud130 \ud30c\uc774\ud504\ub77c\uc778 \ud1b5\ud569","text":"<ul> <li><code>data_loader.py</code>: \uae30\uc874\uc758 <code>pd.merge_asof</code> \ub85c\uc9c1\uc744 \uc644\uc804\ud788 \uc81c\uac70\ud588\uc2b5\ub2c8\ub2e4. \ub300\uc2dc\ubcf4\ub4dc\ub294 \uc774\uc81c \uceec\ub7fc\uba85\uc744 \ubd84\uc11d\ud574 \uc790\ub3d9\uc73c\ub85c <code>resource</code>\uc640 <code>process</code> \ub370\uc774\ud130\ub97c \uc2dd\ubcc4\ud558\uba70, \uc815\ud655\ud788 \uc77c\uce58\ud558\ub294 <code>Timestamp</code>\ub97c \uae30\uc900\uc73c\ub85c \ubcd1\ud569(<code>pd.merge</code>)\uc744 \uc218\ud589\ud569\ub2c8\ub2e4.</li> <li><code>app.py</code>: \uc0c8\ub85c\uc6b4 \ud30c\uc774\uc36c \uc218\uc9d1 \uba54\ucee4\ub2c8\uc998\uc774 \uc790\uccb4\uc801\uc778 \uc218\uc9d1/\uc9d1\uacc4 \uc8fc\uae30\ub97c \ud1b5\uc81c\ud558\ubbc0\ub85c, \ub300\uc2dc\ubcf4\ub4dc\uc5d0\uc11c \uc218\uc9d1 \uc8fc\uae30\ub97c \ub3d9\uc801\uc73c\ub85c \uc124\uc815\ud558\ub358 \ub808\uac70\uc2dc UI \ucee8\ud2b8\ub864\uc744 \uc81c\uac70\ud588\uc2b5\ub2c8\ub2e4. \ub0a0\uc9dc \uae30\ubc18 \ub85c\uadf8 \uc120\ud0dd UI\ub85c \ubcc0\uacbd\ud558\uc5ec, \uc624\ub298 \uae30\uc900 \ucd5c\uadfc 1\uc8fc\uc77c \uc774\ub0b4 \ub85c\uadf8\ub97c \uc790\ub3d9 \uc120\ud0dd/\ub85c\ub4dc\ud558\ub3c4\ub85d \uc0ac\uc6a9\uc131\uc744 \uac1c\uc120\ud588\uc2b5\ub2c8\ub2e4.</li> <li><code>dashboards/*.py</code>: \ubaa8\ub4e0 \ucc28\ud2b8\uac00 \uba85\uc2dc\uc801\uc778 5\ucd08 Peak/Avg \ud30c\uc0dd \uceec\ub7fc(<code>CPU_Avg(%)</code>, <code>Mem_Usage_Avg(%)</code> \ub4f1)\uc744 \ubc14\ub77c\ubcf4\ub3c4\ub85d \ub9f5\ud551\ud588\uc2b5\ub2c8\ub2e4. <code>storage.py</code>\ub294 \ub4dc\ub77c\uc774\ube0c\uba85\uc73c\ub85c <code>PhysicalDriveX</code> \ubc0f <code>C:</code> \ud615\uc2dd \ubaa8\ub450\ub97c \uc778\uc2dd\ud558\ub3c4\ub85d \uc815\uaddc\uc2dd\uc744 \ud655\uc7a5\ud588\uc2b5\ub2c8\ub2e4.</li> </ul>"},{"location":"Changelog.html#3","title":"3. \uc2e4\ud589 \ub798\ud37c \ubc0f \ubb38\uc11c \uc5c5\ub370\uc774\ud2b8","text":"<ul> <li><code>start_monitor.bat</code> &amp; <code>Monitor.ps1</code>: \uae30\uc874\uc758 Logman \uc758\uc874\uc131\uc744 \uc81c\uac70\ud558\uace0, \ub2e8\uc21c\ud788 \uad00\ub9ac\uc790 \uad8c\ud55c \uc5ec\ubd80\ub97c \uccb4\ud06c\ud55c \ub4a4 <code>.\\venv\\Scripts\\python cli.py start</code>\ub97c \uc2e4\ud589\ud558\ub3c4\ub85d \uacbd\ub7c9\ud654 \ub798\ud37c\ub85c \ucd95\uc18c\ud588\uc2b5\ub2c8\ub2e4.</li> <li>\ubb38\uc11c\ud654(<code>docs/</code>): <code>project_structure.md</code>, <code>user_manual.md</code>, <code>optimization_proposal.md</code> \ud30c\uc77c\uc5d0 \uac78\uccd0 \ud30c\uc774\uc36c \uc218\uc9d1\uae30\uc5d0 \ub300\ud55c \ub0b4\uc6a9\uc744 \uc5c5\ub370\uc774\ud2b8\ud558\uace0, \uc81c\uac70\ub41c \uae30\ub2a5\uacfc \uc2e0\uaddc \uc544\ud0a4\ud14d\ucc98\uc758 \uc758\ub3c4\ub97c \uba85\ud655\ud788 \ubc18\uc601\ud588\uc2b5\ub2c8\ub2e4.</li> </ul>"},{"location":"Changelog.html#_3","title":"\ucd94\uac00 \uac1c\uc120 (\uba54\ubaa8\ub9ac \ub204\uc218 \uc870\uce58)","text":"<ul> <li>Pyrefly \ud30c\uc774\uc36c \uc5b8\uc5b4 \ubd84\uc11d\uae30 \uc548\uc815\ud654: \ud504\ub85c\uc81d\ud2b8\ub97c \ubd88\ub7ec\uc62c \ub54c Pyrefly\uac00 \uc218\ucc9c \uc904\uc758 CSV \ub85c\uadf8 \ub370\uc774\ud130(<code>C:\\SystemLogs</code>)\ub97c \uc2a4\uce94\ud558\uba70 \uba54\ubaa8\ub9ac\ub97c 2GB \uc774\uc0c1 \uc810\uc720\ud558\ub358 \ud604\uc0c1\uc744 \ud574\uacb0\ud558\uae30 \uc704\ud574, <code>pyrightconfig.json</code>\uc744 \ucd94\uac00\ud558\uc5ec \ub85c\uadf8 \ubc0f \ub370\uc774\ud130 \ud3f4\ub354\ub97c \ubd84\uc11d \ub300\uc0c1\uc5d0\uc11c \uc644\uc804 \ubc30\uc81c\ud588\uc2b5\ub2c8\ub2e4.</li> </ul>"},{"location":"Changelog.html#_4","title":"\ud14c\uc2a4\ud2b8 \ubc0f \uac80\uc99d \uacb0\uacfc","text":"<ul> <li>CLI \ub3c4\uad6c TDD \ud14c\uc2a4\ud2b8: <code>pytest</code>(unittest) \uae30\ubc18\uc758 \ud658\uacbd\uc5d0\uc11c \ud30c\uc77c \uc2dc\uc2a4\ud15c \ubaa8\uc758(Mocking)\ub97c \uac70\uce58\uc9c0 \uc54a\uace0, \uc784\uc2dc \ub514\ub809\ud1a0\ub9ac\ub97c \ud1b5\ud574 <code>cli.py</code>\uac00 \uc2e4\uc81c CSV \ud30c\uc77c\uc744 \uc62c\ubc14\ub978 \uc2a4\ud0a4\ub9c8\ub85c \uc0dd\uc131\ud558\ub294\uc9c0 \uac80\uc99d\uc744 \uc644\ub8cc\ud588\uc2b5\ub2c8\ub2e4.</li> <li>\ub300\uc2dc\ubcf4\ub4dc \uc790\uac00 \uac80\uc99d(Headless UI Test): <code>verify_dashboards.py</code>\ub97c \ud1b5\ud574 \ube0c\ub77c\uc6b0\uc800 \uc5c6\uc774\ub3c4 UI \ud30c\uc774\ud504\ub77c\uc778 \ubb34\uacb0\uc131\uc744 \uc0c1\uc2dc \uac80\uc99d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</li> </ul>"},{"location":"Changelog.html#deep-dive-for-juniors","title":"\ud83d\udc68\u200d\ud83d\udcbb \uc8fc\ub2c8\uc5b4 \uac1c\ubc1c\uc790\ub97c \uc704\ud55c \ub525\ub2e4\uc774\ube0c \uac00\uc774\ub4dc (Deep Dive for Juniors)","text":"<p>\uc774\ubc88 \uc5c5\ub370\uc774\ud2b8\uc5d0\uc11c \ud574\uacb0\ub41c \uae4c\ub2e4\ub85c\uc6b4 \ubc84\uadf8 2\uac00\uc9c0\uc640, \uc548\uc815\uc131\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \ub3c4\uc785\ub41c TDD(Test-Driven Development) \ud14c\uc2a4\ud2b8 \uae30\ubc95\uc758 \ud575\uc2ec\uc744 \uc0c1\uc138\ud788 \uae30\ub85d\ud569\ub2c8\ub2e4. \uc774 \ubb38\uc11c\ub97c \ud1b5\ud574 \ud30c\uc774\uc36c \uc218\uc9d1\uae30\uc640 \ub300\uc2dc\ubcf4\ub4dc\uc758 \uc5f0\ub3d9 \uc6d0\ub9ac\ub97c \uc27d\uac8c \ud30c\uc545\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p>"},{"location":"Changelog.html#1-null-byte","title":"1. \uc5d1\uc140 \ubcc0\ud658 \ud06c\ub798\uc2dc\uc640 \"\uc720\ub839 \uc81c\uc5b4 \ubb38\uc790(Null Byte)\"\uc758 \ube44\ubc00","text":"<p>\ub300\uc2dc\ubcf4\ub4dc\uc5d0\uc11c \uc5d1\uc140(<code>openpyxl</code>)\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uac70\ub098 \ucc28\ud2b8\ub97c \uc5f4 \ub54c <code>IllegalCharacterError: DiskTime_:,:,C:,:(%)</code> \uc5d0\ub7ec\uac00 \ubc1c\uc0dd\ud558\uc5ec <code>C:</code> \ub4dc\ub77c\uc774\ube0c\uac00 \ub204\ub77d\ub41c \uc801\uc774 \uc788\uc2b5\ub2c8\ub2e4. * \uc6d0\uc778\uc758 \ubc1c\uacac: \ud30c\uc774\uc36c \uc218\uc9d1\uae30\uac00 <code>subprocess</code> \ubaa8\ub4c8\ub85c \uc708\ub3c4\uc6b0 \ud30c\uc6cc\uc258\uc758 <code>Get-Partition</code> \uba85\ub839\uc5b4\ub97c \ud638\ucd9c\ud560 \ub54c, \uc708\ub3c4\uc6b0 \uc778\ucf54\ub529 \ud658\uacbd\uc5d0 \ub530\ub77c \ub208\uc5d0 \ubcf4\uc774\uc9c0 \uc54a\ub294 \ud2b9\uc218 \uc81c\uc5b4 \ubb38\uc790(<code>\\x00</code> \ub4f1 Null byte) \ub098 \ube48 \ubb38\uc790\uc5f4\uc774 \ud30c\uc774\ud504\ub97c \ud0c0\uace0 \ub4e4\uc5b4\uc654\uc2b5\ub2c8\ub2e4. \uc774 \uc4f0\ub808\uae30 \uac12\ub4e4\uc774 \uac78\ub7ec\uc9c0\uc9c0 \uc54a\uc740 \ucc44 \ub4dc\ub77c\uc774\ube0c \ubb38\uc790\ub85c \ubb34\ubd84\ubcc4\ud558\uac8c \uc870\ud569\ub418\ub2e4 \ubcf4\ub2c8 \uceec\ub7fc \uc774\ub984 \ud14d\uc2a4\ud2b8 \ub0b4\ubd80\uc5d0 \uc9c0\ub8b0\ucc98\ub7fc \ubc15\ud614\ub358 \uac83\uc785\ub2c8\ub2e4. * \uc544\ud0a4\ud14d\ucc98 \ub808\ubca8\uc758 \ud574\uacb0\ucc45 (\uc815\uaddc\ud654 \ubc0f \ubcf5\uad6c):   1. \uc6d0\ucc9c \ucc28\ub2e8 (<code>collectors/sampler.py</code>): \uc774\uc81c \ud30c\uc6cc\uc258 \ucd9c\ub825\uc744 \ud30c\uc2f1\ud560 \ub54c <code>str.isalpha()</code>\uc640 <code>len() == 1</code>\uc744 \ubb38\ub9e5\uc801\uc73c\ub85c \uac80\uc0ac\ud558\uc5ec \uc624\ub85c\uc9c0 A-Z \uc54c\ud30c\ubcb3 \ub2e8 \ud55c \uae00\uc790\ub9cc \ub4dc\ub77c\uc774\ube0c\uba85\uc73c\ub85c \uc5c4\uaca9\ud558\uac8c \uc778\uc815\ud569\ub2c8\ub2e4.   2. \uacfc\uac70 \ub370\uc774\ud130 \uc790\uac00 \uce58\uc720 (<code>data_loader.py</code>): \uc774\ubbf8 \uc2dc\uc2a4\ud15c\uc5d0 \uc624\uc5fc\ub41c \uc61b\ub0a0 CSV \ud30c\uc77c\uc744 \uc77d\uc744 \ub54c \ub300\uc2dc\ubcf4\ub4dc\uac00 \ud130\uc9c0\uc9c0 \uc54a\ub3c4\ub85d, \ub85c\ub529 \uc9c1\ud6c4 <code>re.search(r'_(.*?)([A-Z]:(?:,[A-Z]:)*|PhysicalDrive\\d+)(.*?)\\(')</code> \uc815\uaddc\uc2dd\uc744 \ub3cc\ub9bd\ub2c8\ub2e4. \uc774 \uac15\ub825\ud55c \uc815\uaddc\uc2dd\uc740 \uc624\uc5fc\ub41c \ubb38\uc790\uc5f4 \ub354\ubbf8 \uc18d\uc5d0\uc11c <code>C:</code> \ub098 <code>D:,H:</code> \uac19\uc740 \uc9c4\uc9dc \ub4dc\ub77c\uc774\ube0c\uba85\ub9cc \uc218\uc220\ud558\ub4ef \ucd94\ucd9c\ud574\ub0b4\uc5b4 \uce90\uc2dc \uba54\ubaa8\ub9ac\uc5d0 \ub36e\uc5b4\uc501\ub2c8\ub2e4. (\u203b \ucc38\uace0: <code>(?:,[A-Z]:)*</code> \ud328\ud134\uc740 \uc815\uaddc\uc2dd\uc5d0\uc11c <code>D:,E:</code> \ucc98\ub7fc \ubcfc\ub968\uc774 \uc5ec\ub7ec \uac1c \ud569\uccd0\uc9c4 \uc5e3\uc9c0 \ucf00\uc774\uc2a4\uae4c\uc9c0 \ubaa8\ub450 \ub9e4\uce6d\uc2dc\ud0a4\ub294 \ubb38\ubc95\uc785\ub2c8\ub2e4.)</p>"},{"location":"Changelog.html#2-gui-verify_dashboardspy-mocking","title":"2. \ube0c\ub77c\uc6b0\uc800 \uc5c6\uc774 GUI\ub97c \ud14c\uc2a4\ud2b8\ud55c\ub2e4? <code>verify_dashboards.py</code> (Mocking \uae30\ubc95)","text":"<p>Streamlit \ub300\uc2dc\ubcf4\ub4dc UI\ub97c \uc218\uc815\ud558\ub2e4 \ubcf4\uba74 \ub098\uce68\ubc18 \uc5c6\uc774 \ud56d\ud574\ud558\ub294 \uac83\ucc98\ub7fc \ubc84\uadf8\ub97c \ub193\uce58\uae30 \uc27d\uc2b5\ub2c8\ub2e4. AI \uc5d0\uc774\uc804\ud2b8\ub098 \uc790\ub3d9\ud654\ub41c CI/CD \ud30c\uc774\ud504\ub77c\uc778\uc740 \uc9c1\uc811 \ube0c\ub77c\uc6b0\uc800\ub97c \ub744\uc6cc\uc11c \uc2a4\ud1a0\ub9ac\uc9c0 \ud0ed\uc744 \ub9e4\ubc88 \ub20c\ub7ec\ubcfc \uc218 \uc5c6\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. * \ud574\uacb0\ucc45\uc758 \ub3c4\uc785: \uc774\ub97c \uadf9\ubcf5\ud558\uae30 \uc704\ud574 \ud5e4\ub4dc\ub9ac\uc2a4(Headless) \uc790\uac00 \uac80\uc99d \uc2a4\ud06c\ub9bd\ud2b8\uc778 <code>verify_dashboards.py</code>\ub97c \ub8e8\ud2b8 \ub514\ub809\ud1a0\ub9ac\uc5d0 \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4. * \uc791\ub3d9 \uc6d0\ub9ac (MagicMock): Streamlit \ub77c\uc774\ube0c\ub7ec\ub9ac(<code>st</code>)\uc758 \uadf8\ub798\ud53d \uac1d\uccb4\ub4e4\uc744 \ud30c\uc774\uc36c\uc758 <code>unittest.mock.MagicMock</code>\uc774\ub77c\ub294 '\uac00\uc9dc(Mock) \uac1d\uccb4' \uc778\ud130\ud398\uc774\uc2a4\ub85c \ubc14\uafd4\uce58\uae30\ud569\ub2c8\ub2e4.    * \uc608\ub97c \ub4e4\uc5b4 \ub300\uc2dc\ubcf4\ub4dc \ucf54\ub4dc\uac00 <code>st.plotly_chart(fig)</code>\ub97c \ud638\ucd9c\ud558\uba74, \ubaa8\ub2c8\ud130 \ud654\uba74\uc5d0 \uc2e4\uc81c\ub85c \ub80c\ub354\ub9c1\ud558\ub294 \ub300\uc2e0 \uac00\uc9dc \uac1d\uccb4\uac00 \"\uc544, \ubc29\uae08 <code>fig</code> \ucc28\ud2b8 \ud568\uc218\uac00 \uc5d0\ub7ec \uc5c6\uc774 \ud638\ucd9c\ub418\uc5c8\uad6c\ub098!\" \ud558\uace0 \uba54\ubaa8\ub9ac\uc5d0 \uc131\uacf5 \uae30\ub85d\ub9cc \ub0a8\uae41\ub2c8\ub2e4.   * \ud14c\uc2a4\ud2b8 \uc2a4\ud06c\ub9bd\ud2b8\ub294 \ucd5c\uc2e0 \ub85c\uadf8 \ub370\uc774\ud130\ud504\ub808\uc784\uc5d0\uc11c \ub531 \ucd5c\uc0c1\ub2e8 1\uc904(<code>df.head(1)</code>)\ub9cc \uc798\ub77c\ub0b4\uc5b4 \ube5b\uc758 \uc18d\ub3c4\ub85c 4\uac1c\uc758 \ub300\uc2dc\ubcf4\ub4dc \ub3c4\uba54\uc778 \ud568\uc218\ub97c \ud1b5\uacfc\uc2dc\ud0b5\ub2c8\ub2e4.   * \ub9cc\uc57d \uc774 \uacfc\uc815\uc5d0\uc11c \uc5d0\ub7ec(\uc608: \uceec\ub7fc \ub9e4\uce6d \uc2e4\ud328, \uc790\ub8cc\ud615 \uc5d0\ub7ec)\uac00 \ub2e8 1\uac1c\ub77c\ub3c4 \ubc1c\uc0dd\ud558\uba74 \uc2a4\ud06c\ub9bd\ud2b8\uac00 \ubd89\uc740\uc0c9 \uc608\uc678 \ucc98\ub9ac\ub97c \ubc18\ud658\ud558\uba70, \ubb34\uc0ac\ud788 \uc0dd\uc874\ud558\uba74 <code>\ud83c\udf89 Self-Test Suite Completed!</code>\ub97c \ub744\uc6c1\ub2c8\ub2e4.   * \uc8fc\ub2c8\uc5b4 \uac00\uc774\ub4dc\ub77c\uc778: \uc55e\uc73c\ub85c \ub300\uc2dc\ubcf4\ub4dc\uc758 \ub370\uc774\ud130 \ud30c\uc2f1 \uaddc\uce59\uc744 \ubcc0\uacbd\ud558\uac70\ub098 \ud30c\uc774\uc36c \uc218\uc9d1\uae30\ub97c \uac74\ub4dc\ub838\ub2e4\uba74 \ubb34\uc870\uac74 \ube0c\ub77c\uc6b0\uc800 \uc11c\ubc84\ub97c \ucf1c\uae30 \uc804\uc5d0 \uc774 \uc2a4\ud06c\ub9bd\ud2b8 \ud55c \uc904\uc744 \uba3c\uc800 \ud130\ubbf8\ub110\uc5d0 \uccd0\ubcf4\uc138\uc694! \uc5d0\ub7ec\ub97c 1\ucd08 \ub9cc\uc5d0 \uac10\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. (<code>.\\venv\\Scripts\\python verify_dashboards.py</code>)</p>"},{"location":"Changelog.html#_5","title":"\uad6c\ub3d9 \ud14c\uc2a4\ud2b8 \ubc29\ubc95","text":"<ol> <li>\uad00\ub9ac\uc790 \uad8c\ud55c\uc73c\ub85c \uc2e4\ud589\ub41c \ud130\ubbf8\ub110(\ub610\ub294 CMD)\uc744 \uc900\ube44\ud569\ub2c8\ub2e4.</li> <li>\ubc31\uadf8\ub77c\uc6b4\ub4dc\uc5d0\uc11c \uc2e4\ud589 \uc911\uc774\ub358 \ud30c\uc774\uc36c \uc218\uc9d1\uae30\uac00 \uc788\ub2e4\uba74 \uc885\ub8cc\ud569\ub2c8\ub2e4.</li> <li>\uc218\uc9d1\uae30 \uc2e4\ud589: <code>.\\start_monitor.bat</code> (\uc0c8\ub85c\uc6b4 \uad00\ub9ac\uc790 \uc178 \ucc3d\uc774 \ub728\uba70 <code>C:\\SystemLogs</code> \ud3f4\ub354\uc5d0 \ub370\uc774\ud130\ub97c \uae30\ub85d\ud558\uae30 \uc2dc\uc791\ud569\ub2c8\ub2e4.)</li> <li>\ub300\uc2dc\ubcf4\ub4dc \uc2e4\ud589: <code>.\\venv\\Scripts\\python -m streamlit run app.py</code></li> <li>\ub300\uc2dc\ubcf4\ub4dc\uc5d0\uc11c \ub3d9\uc77c\ud55c \ud0c0\uc784\uc2a4\ud0ec\ud504\ub85c \uae30\ub85d\ub418\ub294 CPU/\ub370\uc774\ud130\uc758 Peak \ubc94\uc704\uc640 Average\uac00 \ud55c \uc904\uc758 \ub370\uc774\ud130\ub85c \uc548\uc804\ud558\uac8c \ucd94\uc801\ub418\ub294 \uac83\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.</li> </ol>"},{"location":"reliability_report.html","title":"\uc2dc\uc2a4\ud15c \uc2e0\ub8b0\uc131 \ubc0f \uac80\uc0ac \ud6a8\uc728 \ubd84\uc11d \ubcf4\uace0\uc11c (Reliability Report)","text":""},{"location":"reliability_report.html#1-executive-summary","title":"1. \uac1c\uc694 (Executive Summary)","text":"<p>\ubcf8 \ubcf4\uace0\uc11c\ub294 AOI(Automated Optical Inspection) \uc7a5\ube44\uc758 \uace0\uc815\ubc00 \uac80\uc0ac \ud658\uacbd\uc5d0\uc11c \ubcf8 \ubaa8\ub2c8\ud130\ub9c1 \uc2dc\uc2a4\ud15c\uc774 \uc7a5\ube44 \uc18c\ud504\ud2b8\uc6e8\uc5b4\uc758 \uc131\ub2a5\uacfc \uc2e0\ub8b0\uc131\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc744 \ubd84\uc11d\ud569\ub2c8\ub2e4. \uacbd\uc601\uc9c4(C-Level) \ubc0f QA \ud300\uc740 \ubcf8 \ub3c4\uad6c\ub97c \ud1b5\ud574 \uac80\uc0ac \uc18d\ub3c4(Cycle Time) \uc190\uc2e4 \uc5c6\uc774 \uc2dc\uc2a4\ud15c\uc758 \uc7a0\uc7ac\uc801 \ub9ac\uc2a4\ud06c(Disk I/O \ubcd1\ubaa9, DB \ubd80\ud558 \ub4f1)\ub97c \uac1d\ucc29\ud558\uace0 \ub300\uc751\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p>"},{"location":"reliability_report.html#2-architecture-stability","title":"2. \ubaa8\ub2c8\ud130\ub9c1 \uc544\ud0a4\ud14d\ucc98 \ubc0f \uc548\uc804\uc131 (Architecture &amp; Stability)","text":"<p>\ubcf8 \uc2dc\uc2a4\ud15c\uc740 \uc7a5\ube44\uc758 \uc2e4\uc2dc\uac04 \uac80\uc0ac \ub85c\uc9c1\uacfc \uc644\uc804\ud788 \ubd84\ub9ac\ub41c \ube44\uce68\uc2b5\uc801(Non-invasive) \ubc29\uc2dd\uc744 \ucc44\ud0dd\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.</p> <ul> <li>\uc708\ub3c4\uc6b0 \ud45c\uc900 \uc131\ub2a5 \uce74\uc6b4\ud130 (Logman): OS \uc218\uc900\uc5d0\uc11c \ucee4\ub110 \ub370\uc774\ud130\uc5d0 \uc9c1\uc811 \uc811\uadfc\ud558\ubbc0\ub85c, \uc560\ud50c\ub9ac\ucf00\uc774\uc158 \ub808\ubca8\uc758 CPU \uc810\uc720\uc728\uc774 1% \ubbf8\ub9cc\uc73c\ub85c \uadf9\ud788 \ub0ae\uc2b5\ub2c8\ub2e4. (5\ucd08 \uc8fc\uae30 \uc124\uc815 \uc2dc \uc601\ud5a5\ub3c4 \ubb34\uc2dc \uac00\ub2a5)</li> <li>PowerShell \uae30\ubc18 \ud504\ub85c\uc138\uc2a4 \ucd94\uc801: 30\ucd08\uc758 \uae34 \uc8fc\uae30\ub85c \ub3d9\uc791\ud558\uc5ec, \uac80\uc0ac \uc18c\ud504\ud2b8\uc6e8\uc5b4\uc758 \ud504\ub85c\uc138\uc2a4 \ucee8\ud14d\uc2a4\ud2b8 \uc2a4\uc704\uce6d\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc744 \ucd5c\uc18c\ud654\ud569\ub2c8\ub2e4.</li> <li>\ub370\uc774\ud130 \uc800\uc7a5\uc18c: \uc218\uc9d1\ub41c \ub85c\uadf8\ub294 \ube44\ub3d9\uae30\uc801\uc73c\ub85c \uae30\ub85d\ub418\uba70, \uac80\uc0ac \uc54c\uace0\ub9ac\uc998\uc758 \uba54\ubaa8\ub9ac \uc601\uc5ed\uc744 \uce68\ubc94\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.</li> </ul>"},{"location":"reliability_report.html#3-impact-analysis","title":"3. \ud575\uc2ec \uc2dc\uc2a4\ud15c \uc601\ud5a5 \ubd84\uc11d (Impact Analysis)","text":""},{"location":"reliability_report.html#31-cycle-time","title":"3.1 \uac80\uc0ac \uc18d\ub3c4 (Cycle Time) \ubcf4\uc874","text":"<p>AOI \uac80\uc0ac\ub294 \uace0\ud574\uc0c1\ub3c4 \uc774\ubbf8\uc9c0 \ucc98\ub9ac\uc640 \uc815\ubc00 \uc81c\uc5b4\uac00 \ud575\uc2ec\uc785\ub2c8\ub2e4. \ubcf8 \ub3c4\uad6c\ub294 \ub2e4\uc74c \ubc29\uc2dd\uc73c\ub85c \uac80\uc0ac \uc18d\ub3c4\ub97c \ubcf4\ud638\ud569\ub2c8\ub2e4. - CPU \uc120\uc810 \ubc29\uc9c0: \ubaa8\ub2c8\ud130\ub9c1 \ud504\ub85c\uc138\uc2a4\ub294 \ub0ae\uc740 \uc6b0\uc120\uc21c\uc704\ub85c \ub3d9\uc791\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. - Interrupt \uad00\ub9ac: \ub124\ud2b8\uc6cc\ud06c \uae30\ubc18 \ubaa8\ub2c8\ud130\ub9c1 \ub300\uc2e0 \ub85c\uceec \ub85c\uadf8 \ubc29\uc2dd\uc744 \uc6b0\uc120\ud558\uc5ec \ub124\ud2b8\uc6cc\ud06c \uc9c0\uc5f0\uc5d0 \ub530\ub978 \uc0ac\uc774\ub4dc \uc774\ud399\ud2b8\ub97c \ucc28\ub2e8\ud569\ub2c8\ub2e4.</p>"},{"location":"reliability_report.html#32-db","title":"3.2 \ub85c\uceec DB \uc5d4\uc9c4 \ubc0f \uae30\ud0c0 \ud504\ub85c\uadf8\ub7a8 \ubaa8\ub2c8\ud130\ub9c1","text":"<p>AOI \uc2dc\uc2a4\ud15c\uc5d0\uc11c MSSQL/PostgreSQL \ub4f1 \ub85c\uceec DB\uc758 \uc131\ub2a5 \uc800\ud558\ub294 \uac80\uc0ac \uacb0\uacfc \uae30\ub85d \uc9c0\uc5f0\uc73c\ub85c \uc774\uc5b4\uc9d1\ub2c8\ub2e4. - Disk I/O \ucd94\uc801: DB \uc5d4\uc9c4\uc758 <code>Write Bytes/sec</code>\uc640 <code>Disk Queue Length</code>\ub97c \ubaa8\ub2c8\ud130\ub9c1\ud558\uc5ec, DB \uc800\uc7a5 \uc9c0\uc5f0\uc774 \uac80\uc0ac \uc18d\ub3c4\uc5d0 \ubbf8\uce58\ub294 \uc0c1\uad00\uad00\uacc4\ub97c QA\uac00 \uc989\uc2dc \ud30c\uc545\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. - \uc790\uc6d0 \uacbd\ud569 \ud0d0\uc0c9: \ud0c0\uc0ac \ubc31\uc2e0\uc774\ub098 \uae30\ud0c0 \ubc31\uadf8\ub77c\uc6b4\ub4dc \ud504\ub85c\uadf8\ub7a8\uc774 CPU \ud53c\ud06c\ub97c \uc720\ubc1c\ud560 \ub54c, \ud574\ub2f9 \uc2dc\uc810\uc5d0 AOI \uac80\uc0ac\uac00 \uc9c0\uc5f0\ub418\uc5c8\ub294\uc9c0 \ud0c0\uc784\ub77c\uc778\uc744 \ud1b5\ud574 \uad50\ucc28 \uac80\uc99d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p>"},{"location":"reliability_report.html#4-qa-operational-strategy","title":"4. QA \uc6b4\uc601 \uc804\ub7b5 (Operational Strategy)","text":"<p>QA \ud300\uc740 \ubcf8 \ub3c4\uad6c\ub97c \ud1b5\ud574 \ub2e4\uc74c\uacfc \uac19\uc740 OS \ub808\ubca8\uc758 \uc774\uc288\ub97c \uc9c4\ub2e8\ud569\ub2c8\ub2e4.</p> <ol> <li>\uba54\ubaa8\ub9ac \ub9ad(Memory Leak) \uc870\uae30 \ubc1c\uacac: \uac80\uc0ac \uc18c\ud504\ud2b8\uc6e8\uc5b4\uc758 \uba54\ubaa8\ub9ac \uc810\uc720\uc728\uc774 \uc2dc\uac04\uc5d0 \ub530\ub77c \uc6b0\uc0c1\ud5a5 \ud558\ub294\uc9c0 \uac10\uc2dc\ud558\uc5ec \uc7a5\uae30 \uac00\ub3d9 \uc2dc\uc758 \uc7a5\ube44 \ub2e4\uc6b4\ud0c0\uc784\uc744 \uc608\ubc29\ud569\ub2c8\ub2e4.</li> <li>\ub514\uc2a4\ud06c \ub178\ud6c4\ud654 \uc9c4\ub2e8: \ud2b9\uc815 \uc77c\uc2dc\ubd80\ud130 <code>Disk Read/Write</code> \uc18d\ub3c4\uac00 \uc800\ud558\ub418\uac70\ub098 \ud050 \uae38\uc774\uac00 \ub298\uc5b4\ub098\ub294 \uacbd\uc6b0, \uc7a5\ube44\uc758 SSD/HDD \uad50\uccb4 \uc2dc\uae30\ub97c \uac1d\uad00\uc801 \uc218\uce58\ub85c \uc81c\uc548\ud569\ub2c8\ub2e4.</li> <li>\uac80\uc0ac \uc18d\ub3c4 \uc0c1\uad00\uad00\uacc4 \ubd84\uc11d: \uc81c\ud488 \uac80\uc0ac \uc2dc\uac04\uc774 \ud3c9\uc18c\ubcf4\ub2e4 \uae38\uc5b4\uc9c4 \uacbd\uc6b0, \ud574\ub2f9 \uad6c\uac04\uc758 CPU \ud53c\ud06c \uc5ec\ubd80\ub97c \ud655\uc778\ud558\uc5ec \ucf54\ub4dc \ucd5c\uc801\ud654 \ud544\uc694\uc131\uc744 \ud310\ub2e8\ud569\ub2c8\ub2e4.</li> </ol>"},{"location":"reliability_report.html#5-conclusion","title":"5. \uacb0\ub860 (Conclusion)","text":"<p>\ubcf8 \ubaa8\ub2c8\ud130\ub9c1 \uc2dc\uc2a4\ud15c\uc740 AOI \uc7a5\ube44\uc758 \uace0\uc720 \uae30\ub2a5\uc744 \uc800\ud574\ud558\uc9c0 \uc54a\uc73c\uba74\uc11c\ub3c4, \uc2dc\uc2a4\ud15c\uc758 \ud22c\uba85\uc131\uc744 \uadf9\ub300\ud654\ud569\ub2c8\ub2e4. \uc774\ub294 \uc7a5\ube44\uc758 \uac00\uc131\ube44(Uptime)\ub97c \ub192\uc774\uace0, \ud604\uc7a5\uc5d0\uc11c \ubc1c\uc0dd\ud558\ub294 \uc6d0\uc778 \ubd88\uba85\uc758 \uac80\uc0ac \uc9c0\uc5f0 \uc774\uc288\ub97c \ub370\uc774\ud130 \uae30\ubc18(Data-driven)\uc73c\ub85c \ud574\uacb0\ud558\ub294 \uac15\ub825\ud55c QA \uae30\ubc18\uc774 \ub429\ub2c8\ub2e4.</p>"}]}